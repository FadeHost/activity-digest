# A FadeHost access token with the read scope.
# Profile -> AI Access: https://laplace.fadehost.com/profile/ai-access
FADEHOST_TOKEN=

# Where the daily digest is posted.
# Discord -> your channel -> Edit Channel -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# The hour (UTC, 0 to 23) the digest goes out.
DIGEST_HOUR=9

# Which servers to watch, comma separated. Empty means all of them.
SERVER_IDS=

# The port to listen on. FadeHost sets this for you.
PORT=8080
